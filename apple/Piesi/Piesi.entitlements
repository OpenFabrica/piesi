<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- apple/Piesi/Piesi.entitlements —— 主应用非沙盒（直接分发，设计 5.1）。hardened runtime 在 build setting 里开。
     App Group 只用来和 Finder 右键菜单扩展交接请求（PiesiFinder/FinderRequest.swift）；以团队 ID 开头，macOS 上不需要描述文件。 -->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(DEVELOPMENT_TEAM).com.citrolabs.piesi</string>
	</array>
</dict>
</plist>
