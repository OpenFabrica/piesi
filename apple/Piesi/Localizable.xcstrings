    "%@：unrar 拒绝还原该符号链接（目标不安全或读取失败），已跳过": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: unrar refused to restore this symbolic link (unsafe target or read failure), skipped"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：unrar がシンボリックリンクの復元を拒否（安全でないリンク先または読み取り失敗）、スキップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：unrar 拒绝还原该符号链接（目标不安全或读取失败），已跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：unrar 拒絕還原該符號連結（目標不安全或讀取失敗），已略過"
          }
        }
      }
    },
