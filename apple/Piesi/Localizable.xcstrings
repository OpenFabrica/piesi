    "%@：unrar 拒绝还原该符号链接（目标不安全或读取失败），已跳过": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: unrar refused to restore this symbolic link (unsafe target or read failure), skipped"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：unrar がシンボリックリンクの復元を拒否（安全でないリンク先または読み取り失敗）、スキップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：unrar 拒绝还原该符号链接（目标不安全或读取失败），已跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：unrar 拒絕還原該符號連結（目標不安全或讀取失敗），已略過"
          }
        }
      }
    },
    "%@：引用记录（rar -oi）暂不支持，已跳过": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: reference records (rar -oi) aren’t supported yet, skipped"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：参照レコード（rar -oi）は未対応のためスキップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：引用记录（rar -oi）暂不支持，已跳过"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@：引用記錄（rar -oi）暫不支援，已略過"
          }
        }
      }
    },
    "%@：条目没有数据，已跳过": {
