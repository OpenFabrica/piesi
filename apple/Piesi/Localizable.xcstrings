            "state": "translated",
            "value": "ZIP can’t encrypt file names (only 7z can); names were left unencrypted"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZIP ではファイル名を暗号化できません（7z のみ）。ファイル名は暗号化されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
