    "包只有 %@，展开却要 %@，超过磁盘剩余的 %@。已停止。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive is only %1$@ but expands to %2$@, more than the %3$@ free on disk. Stopped."
          }
