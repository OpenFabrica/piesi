{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "NSDesktopFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi needs access to your Desktop folder to extract or create archives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi がアーカイブを展開または作成するには「デスクトップ」フォルダへのアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi 需要访问「桌面」文件夹以解压或创建压缩包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi 需要存取「桌面」資料夾以解壓縮或建立壓縮檔。"
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi needs access to your Documents folder to extract or create archives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi がアーカイブを展開または作成するには「書類」フォルダへのアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi 需要访问「文稿」文件夹以解压或创建压缩包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi 需要存取「文件」資料夾以解壓縮或建立壓縮檔。"
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi needs access to your Downloads folder to extract or create archives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi がアーカイブを展開または作成するには「ダウンロード」フォルダへのアクセスが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi 需要访问「下载」文件夹以解压或创建压缩包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi 需要存取「下載」資料夾以解壓縮或建立壓縮檔。"
          }
        }
      }
    },
    "用 Piesi 压缩": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compress with Piesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi で圧縮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Piesi 壓縮"
          }
        }
      }
    },
    "用 Piesi 查看": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View with Piesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi で表示"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Piesi 查看"
          }
        }
      }
    },
    "用 Piesi 解压到此处": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract Here with Piesi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Piesi でここに展開"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Piesi 解壓縮到這裡"
          }
        }
      }
    }
  },
  "version": "1.0"
}
